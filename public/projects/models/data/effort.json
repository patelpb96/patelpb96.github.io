{
 "title": "Frontier effort comparison",
 "as_of": "2026-11-25",
 "source": {
  "name": "Artificial Analysis",
  "url": "https://artificialanalysis.ai/"
 },
 "note": "Every number is Artificial Analysis's own measurement of one reasoning-effort setting of one model, copied as published (artificialanalysis.ai). Cost and time are what it took to run AA's Intelligence Index tasks at that setting, so they move with how much the model thinks. A model AA has stopped listing keeps its last published setting and is marked as not live. Effort names differ between labs (Gemini stops at high, Claude and GPT go to max), so compare ladders for shape rather than matching names one to one. More effort does not always score higher.",
 "effort_order": [
  "none",
  "minimal",
  "low",
  "medium",
  "high",
  "xhigh",
  "max"
 ],
 "metrics": [
  {
   "id": "aa_intelligence_index",
   "name": "AA Intelligence Index",
   "category": "composite",
   "unit": "index points",
   "higher_is_better": true,
   "blurb": "One number over a fixed suite of benchmarks run by Artificial Analysis rather than the model vendors; higher is better."
  },
  {
   "id": "superscore",
   "name": "Superscore",
   "category": "composite",
   "unit": "ln",
   "higher_is_better": true,
   "blurb": "The natural log of: output tok/s x price per 1M tokens x Intelligence Index x (non-hallucination rate / 100), divided by (time per task in seconds x cost per task), from each setting's own Artificial Analysis row. Each +1 is about 2.7 times the raw score. Cost and time are already inside it, so read it as a ranking with the horizontal axis for context."
  },
  {
   "id": "aa_cost_per_task",
   "name": "AA Cost per task",
   "category": "cost",
   "unit": "USD",
   "higher_is_better": false,
   "blurb": "USD Artificial Analysis spent running its task suite on this model at the stated effort setting; lower is cheaper. It reflects how many tokens the model uses, not only its price per token."
  },
  {
   "id": "aa_time_per_task",
   "name": "AA Time per task",
   "category": "speed",
   "unit": "minutes",
   "higher_is_better": false,
   "blurb": "Minutes the same suite took end to end at the stated effort setting; lower is faster."
  },
  {
   "id": "aa_omniscience",
   "name": "AA-Omniscience",
   "category": "knowledge",
   "unit": "net score",
   "higher_is_better": true,
   "blurb": "Knowledge reliability: correct answers minus hallucinations, -100 to 100; refusing costs nothing."
  },
  {
   "id": "aa_terminalbench_4",
   "name": "Terminal-Bench 4.0",
   "category": "agentic",
   "unit": "%",
   "higher_is_better": true,
   "blurb": "Multi-step tasks in a real command-line environment, run by Artificial Analysis; % solved."
  },
  {
   "id": "aa_frontiercode_2",
   "name": "FrontierCode 2.0",
   "category": "coding",
   "unit": "%",
   "higher_is_better": true,
   "blurb": "Hard, recent software-engineering tasks; % solved."
  },
  {
   "id": "aa_hle_diamond",
   "name": "HLE-Diamond",
   "category": "reasoning",
   "unit": "%",
   "higher_is_better": true,
   "blurb": "The hardest verified subset of Humanity's Last Exam; % correct."
  },
  {
   "id": "aa_critpt_v2_hard",
   "name": "CritPt v2 (hard)",
   "category": "reasoning",
   "unit": "%",
   "higher_is_better": true,
   "blurb": "Research-level physics problems, hard subset; % correct."
  },
  {
   "id": "aa_gdp_pdf",
   "name": "GDP.pdf",
   "category": "documents",
   "unit": "%",
   "higher_is_better": true,
   "blurb": "Answering questions from long economic PDF reports; % fully correct."
  },
  {
   "id": "aa_automationbench",
   "name": "AutomationBench",
   "category": "agentic",
   "unit": "%",
   "higher_is_better": true,
   "blurb": "Artificial Analysis's business-automation tasks across tools and apps; partial-credit score in %."
  },
  {
   "id": "aa_briefcase_elo",
   "name": "AA-Briefcase",
   "category": "agentic",
   "unit": "Elo",
   "higher_is_better": true,
   "blurb": "Agentic knowledge work (analyst-style briefs) judged head to head; an Elo rating, higher is better."
  },
  {
   "id": "aa_non_hallucination",
   "name": "Non-hallucination rate",
   "category": "knowledge",
   "unit": "%",
   "higher_is_better": true,
   "blurb": "Share of AA-Omniscience questions it did not answer wrongly (100 minus the hallucination rate); %."
  },
  {
   "id": "aa_terminalbench_science",
   "name": "Terminal-Bench Science",
   "category": "reasoning",
   "unit": "%",
   "higher_is_better": true,
   "blurb": "Scientific computing tasks in a terminal; % solved."
  },
  {
   "id": "aa_mmmu_pro",
   "name": "MMMU-Pro",
   "category": "vision",
   "unit": "%",
   "higher_is_better": true,
   "blurb": "College-level questions that need images and text together; % correct."
  },
  {
   "id": "aa_hle",
   "name": "Humanity's Last Exam",
   "category": "reasoning",
   "unit": "%",
   "higher_is_better": true,
   "blurb": "2,500 expert-written questions across maths, science and the humanities; % correct."
  },
  {
   "id": "aa_scicode",
   "name": "SciCode",
   "category": "coding",
   "unit": "%",
   "higher_is_better": true,
   "blurb": "Scientific programming problems from research code; % of sub-problems solved."
  },
  {
   "id": "aa_lcr",
   "name": "Long-context reasoning",
   "category": "long context",
   "unit": "%",
   "higher_is_better": true,
   "blurb": "Artificial Analysis's reasoning questions over very long documents; % correct."
  }
